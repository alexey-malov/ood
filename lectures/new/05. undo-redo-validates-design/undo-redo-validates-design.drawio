        <mxCell id="KlV27tbleSOprnjG0Gix-42" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Пользователь видит будущий результат&lt;/b&gt;&lt;/font&gt;&lt;div&gt;Фигура визуально следит за мышью, но измение ещё не сохранено&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
